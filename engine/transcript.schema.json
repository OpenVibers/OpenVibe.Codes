{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://openvibe.codes/schemas/engine/transcript@1",
    "title": "OpenVibe.Codes transcript",
    "description": "One event shape for every harness's log: Claude Code stream-json, Codex, Command Code, OpenCode, dsh --json and MiniMax Code stream-json. The normaliser lives in engine/transcript.js.",
    "type": "object",
    "required": ["events"],
    "properties": {
        "events": {
            "type": "array",
            "description": "The conversation, in order.",
            "items": { "$ref": "#/$defs/event" }
        },
        "session": {
            "type": ["string", "null"],
            "description": "The harness's session id, when it reported one (a continue needs it)."
        },
        "model": {
            "type": ["string", "null"],
            "description": "The model that worked on it, when the feed said."
        },
        "cwd": {
            "type": ["string", "null"],
            "description": "The folder it worked in."
        },
        "usage": {
            "type": "object",
            "description": "The tokens it used.",
            "properties": {
                "input": { "type": "number", "minimum": 0 },
                "output": { "type": "number", "minimum": 0 },
                "cached": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
        },
        "cost": {
            "type": ["number", "null"],
            "description": "The dollars the feed reported, when it reported any."
        },
        "line": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of feed lines that were read."
        },
        "findings": {
            "type": "array",
            "description": "The structured findings of the task's review, in the agent.finding@1 shape (OpenVibe.Contracts): a confirmed finding carries severity and confidence; a needs_validation lead carries a claimed cause, exact blockers and a validation plan and no severity; a rejected claim carries its reason. Empty or absent when no review produced a record.",
            "items": { "$ref": "#/$defs/finding" }
        },
        "review": {
            "type": "object",
            "description": "The persisted review ledger: its findings across revisions with a stable finding_id and an ACTIVE/RESOLVED state, the reconciliation counts, and the addressed/reappeared/still open/new line. A review that did not run is `unreviewed` with no findings, never a zero-finding approval.",
            "additionalProperties": false,
            "required": ["verdict", "findings", "lifecycle"],
            "properties": {
                "verdict": { "type": "string", "enum": ["approved", "changes_requested", "unreviewed"] },
                "summary": { "type": "string", "maxLength": 4000 },
                "findings": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/reviewFinding" } },
                "lifecycle": { "$ref": "#/$defs/reviewLifecycle" },
                "lifecycle_line": { "type": ["string", "null"] }
            }
        }
    },
    "additionalProperties": true,
    "$defs": {
        "event": {
            "type": "object",
            "required": ["t"],
            "description": "One event of the conversation.",
            "properties": {
                "t": {
                    "type": "string",
                    "enum": ["user", "text", "thinking", "tool", "error", "final", "meta"],
                    "description": "The kind of event."
                },
                "text": {
                    "type": "string",
                    "description": "The words: what was said, thought, or went wrong."
                },
                "name": {
                    "type": "string",
                    "description": "The tool's name (on a tool event)."
                },
                "kind": {
                    "type": "string",
                    "enum": ["shell", "read", "edit", "search", "web", "plan", "tool"],
                    "description": "What kind of tool it was (on a tool event)."
                },
                "summary": {
                    "type": "string",
                    "description": "One line about what the tool was asked to do."
                },
                "input": {
                    "type": "object",
                    "description": "What the tool was given.",
                    "properties": {
                        "text": { "type": "string" },
                        "more": { "type": "number", "minimum": 0 }
                    },
                    "required": ["text"],
                    "additionalProperties": true
                },
                "output": {
                    "type": ["object", "null"],
                    "description": "What the tool answered, once it did.",
                    "properties": {
                        "text": { "type": "string" },
                        "more": { "type": "number", "minimum": 0 }
                    },
                    "required": ["text"],
                    "additionalProperties": true
                },
                "at": {
                    "type": ["string", "null"],
                    "format": "date-time",
                    "description": "When it happened (ISO 8601), when the feed said."
                },
                "ts": {
                    "type": ["number", "null"],
                    "description": "When it happened, in milliseconds since the epoch."
                },
                "line": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "The feed line it came from."
                },
                "i": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Its index in the event list."
                },
                "id": {
                    "type": "string",
                    "description": "The tool call's id (on a tool event)."
                },
                "pending": {
                    "type": "boolean",
                    "description": "The tool has not answered yet."
                },
                "isError": {
                    "type": "boolean",
                    "description": "It failed."
                },
                "exit": {
                    "type": "number",
                    "description": "The exit code of the command (on a tool event)."
                },
                "v": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "How often this event changed."
                },
                "partial": {
                    "type": "boolean",
                    "description": "The words are still streaming in."
                },
                "answer": {
                    "type": "boolean",
                    "description": "This message is the answer of the turn."
                },
                "session": {
                    "type": "string",
                    "description": "The session id (on a meta event)."
                },
                "model": {
                    "type": "string",
                    "description": "The model (on a meta event)."
                    },
                "cwd": {
                    "type": "string",
                    "description": "The folder (on a meta event)."
                }
            },
            "additionalProperties": true
        },
        "finding": {
            "type": "object",
            "description": "One review finding (agent.finding@1): the verdict is the evidence bar; a needs_validation lead has no severity.",
            "additionalProperties": false,
            "required": ["verdict", "fingerprint", "title", "description", "trace", "evidence"],
            "properties": {
                "verdict": { "type": "string", "enum": ["confirmed", "needs_validation", "rejected"] },
                "fingerprint": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Repository-relative file + whitespace-normalised, lowercased text; stable across re-wrapping." },
                "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
                "trace": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/findingLocation" } },
                "evidence": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/findingEvidence" } },
                "severity": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["likelihood", "impact", "overall_severity"],
                    "properties": {
                        "likelihood": { "$ref": "#/$defs/findingLevel" },
                        "impact": { "$ref": "#/$defs/findingLevel" },
                        "overall_severity": { "$ref": "#/$defs/findingLevel" }
                    }
                },
                "confidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["level", "reason"],
                    "properties": {
                        "level": { "type": "string", "enum": ["low", "medium", "high"] },
                        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
                    }
                },
                "remediation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["strategy"],
                    "properties": {
                        "strategy": { "type": "string", "minLength": 1, "maxLength": 2000 },
                        "code_changes": {
                            "type": "array",
                            "maxItems": 20,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["file", "change"],
                                "properties": {
                                    "file": { "type": "string", "minLength": 1, "maxLength": 500 },
                                    "change": { "type": "string", "minLength": 1, "maxLength": 1000 }
                                }
                            }
                        }
                    }
                },
                "claimed_root_cause": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "blockers": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
                "validation_plan": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "local": { "type": "string", "minLength": 1, "maxLength": 2000 },
                        "deployment": { "type": "string", "minLength": 1, "maxLength": 2000 }
                    },
                    "anyOf": [ { "required": ["local"] }, { "required": ["deployment"] } ]
                },
                "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
            },
            "allOf": [
                {
                    "if": { "properties": { "verdict": { "const": "confirmed" } }, "required": ["verdict"] },
                    "then": { "required": ["severity", "confidence"] }
                },
                {
                    "if": { "properties": { "verdict": { "const": "needs_validation" } }, "required": ["verdict"] },
                    "then": { "required": ["claimed_root_cause", "blockers", "validation_plan"], "not": { "required": ["severity"] } }
                },
                {
                    "if": { "properties": { "verdict": { "const": "rejected" } }, "required": ["verdict"] },
                    "then": { "required": ["reason"], "not": { "required": ["severity"] } }
                }
            ]
        },
        "findingLocation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
                "file": { "type": "string", "minLength": 1, "maxLength": 500 },
                "line": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
        },
        "findingEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary"],
            "properties": {
                "kind": { "type": "string", "enum": ["source", "command", "response", "screenshot", "log", "test"] },
                "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "location": { "$ref": "#/$defs/findingLocation" },
                "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "output": { "type": "string", "minLength": 1, "maxLength": 4000 }
            }
        },
        "findingLevel": {
            "type": "string",
            "enum": ["informational", "low", "medium", "high", "critical"]
        },
        "reviewFinding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "file", "text", "state"],
            "properties": {
                "finding_id": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Repository-relative file + whitespace-normalised, lowercased text." },
                "file": { "type": "string", "minLength": 1, "maxLength": 500 },
                "line": { "type": ["integer", "null"], "minimum": 1 },
                "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", "critical", null] },
                "axis": { "type": "string", "enum": ["standards", "spec"] },
                "state": { "type": "string", "enum": ["ACTIVE", "RESOLVED"] }
            }
        },
        "reviewLifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["addressed", "reappeared", "still_open", "new"],
            "properties": {
                "addressed": { "type": "integer", "minimum": 0 },
                "reappeared": { "type": "integer", "minimum": 0 },
                "still_open": { "type": "integer", "minimum": 0 },
                "new": { "type": "integer", "minimum": 0 }
            }
        }
    }
}
