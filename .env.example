# OpenVibe.Codes — environment (production: /etc/openvibe/codes.env). Names only; never commit values.

NODE_ENV=production
PORT=4900
HOST=127.0.0.1
BASE_URL=https://openvibe.codes
TRUST_PROXY=2
CODES_DB_PATH=/var/lib/openvibe-codes/codes.db

# OpenVibe.Network: SSO (OAuth client `codes`, PKCE S256), JWKS, the /api/v1/projects API, the registry.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OV_NETWORK_ISSUER=https://openvibe.network        # defaults to OV_NETWORK_URL
OV_OAUTH_CLIENT_ID=codes
OV_OAUTH_CLIENT_SECRET=
# OV_OAUTH_REDIRECT_URI=https://openvibe.codes/auth/callback
# OV_SESSION_AUDIENCE=openvibe.network                # audience a Network session token must carry to be a Codes session

# Signs the per-person form token (CSRF). Unset: a random per-process key (forms expire on restart).
CODES_FORM_SECRET=
# optional: defaults to true in production
# COOKIE_SECURE=true

# Codes staff (trust tiers, metadata only): staff with staff.site.configure (Network admins), plus these
# usr_ subjects (comma list; the break-glass way in).
CODES_STAFF_SUBJECTS=

# Playgrounds call these with the APP's own token (defaults: the public origins in openvibe-contracts).
# CODES_PLAYGROUND_EVENTS_URL=https://events.openvibe.network
# CODES_PLAYGROUND_MEDIA_URL=https://openvibe.media
# CODES_PLAYGROUND_MAX_UPLOAD_BYTES=1048576
# CODES_PLAYGROUND_RUNS_PER_HOUR=60

# Registry answers are cached this long (ms).
# CODES_REGISTRY_TTL_MS=30000

# OpenVibe.Events: the outbox relay (codes.app.published|deprecated|revoked) runs when both
# EVENTS_URL and OV_OAUTH_CLIENT_SECRET are set; otherwise events wait in event_outbox.
EVENTS_URL=http://127.0.0.1:4300
# EVENTS_RELAY_INTERVAL_MS=2000
