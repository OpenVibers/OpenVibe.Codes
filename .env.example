# OpenVibe.Codes — environment (production: /etc/openvibe/codes.env). Names only; never commit values.

NODE_ENV=production
PORT=4900
HOST=127.0.0.1
BASE_URL=https://openvibe.codes
TRUST_PROXY=2
# PostgreSQL (ADR-035), written by OpenVibe.Host roles/data/add-service.sh codes: the runtime role through PgBouncer,
# the owner on a direct connection (migrations), and Valkey (shared limit counters).
# Without DATABASE_URL, development uses an embedded PGlite database in data/pglite.
DATABASE_URL=
DATABASE_DIRECT_URL=
VALKEY_URL=
VALKEY_PREFIX=
# Per-actor limits (server/http/actor-limits.js): reads one caller (a person, else an address) may make to the
# API per minute and per hour; past them 429 rate_limited with Retry-After. The router has its own number
# (README). The per-address limits stay.
#CODES_LIMITS_MINUTE=120
#CODES_LIMITS_HOUR=3000

# OpenVibe.Network: SSO (OAuth client `codes`, PKCE S256) and its JWKS.
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OV_NETWORK_ISSUER=https://openvibe.network        # defaults to OV_NETWORK_URL
OV_OAUTH_CLIENT_ID=codes
OV_OAUTH_CLIENT_SECRET=
# OV_OAUTH_REDIRECT_URI=https://openvibe.codes/auth/callback
# OV_SESSION_AUDIENCE=openvibe.network                # audience a Network session token must carry to be a Codes session

# optional: defaults to true in production
# COOKIE_SECURE=true
