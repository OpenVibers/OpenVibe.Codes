; OpenVibe Git: Forgejo at https://openvibe.codes/git/ (deploy/forgejo/install.sh writes /etc/forgejo/app.ini from this).
; @VALUES@ are filled in on the host; the secrets are generated there and never leave it.
APP_NAME = OpenVibe Git
RUN_USER = forgejo
RUN_MODE = prod
WORK_PATH = /var/lib/forgejo

[server]
PROTOCOL = http
HTTP_ADDR = 127.0.0.1
HTTP_PORT = 5060
DOMAIN = openvibe.codes
ROOT_URL = https://openvibe.codes/git/
; Cloning and pushing are over HTTPS only: openvibe.codes is behind Cloudflare's proxy, which carries no SSH.
DISABLE_SSH = true
START_SSH_SERVER = false
LANDING_PAGE = explore
OFFLINE_MODE = true
LFS_START_SERVER = false
APP_DATA_PATH = /var/lib/forgejo/data

[database]
DB_TYPE = postgres
HOST = 127.0.0.1:5432
NAME = ov_forgejo
USER = forgejo
PASSWD = @DB_PASSWORD@
SSL_MODE = disable
MAX_OPEN_CONNS = 10
MAX_IDLE_CONNS = 4

[repository]
ROOT = /var/lib/forgejo/repositories
DEFAULT_BRANCH = main
DEFAULT_PRIVATE = public

[service]
; People join by signing in with their OpenVibe account (the OpenVibe authentication source); there is no local sign-up.
DISABLE_REGISTRATION = false
ALLOW_ONLY_EXTERNAL_REGISTRATION = true
SHOW_REGISTRATION_BUTTON = false
REQUIRE_SIGNIN_VIEW = false
DEFAULT_KEEP_EMAIL_PRIVATE = true
DEFAULT_ALLOW_CREATE_ORGANIZATION = false
ENABLE_NOTIFY_MAIL = false
NO_REPLY_ADDRESS = noreply.openvibe.codes

[oauth2_client]
ENABLE_AUTO_REGISTRATION = true
; goth's OpenID Connect provider puts the preferred_username claim (the OpenVibe username) in the nickname.
USERNAME = nickname
UPDATE_AVATAR = true
ACCOUNT_LINKING = login
OPENID_CONNECT_SCOPES = openid profile email

[openid]
ENABLE_OPENID_SIGNIN = false
ENABLE_OPENID_SIGNUP = false

[oauth2]
; Forgejo as an OAuth provider is not needed: OpenVibe.Network is the identity provider.
ENABLED = false

[security]
INSTALL_LOCK = true
SECRET_KEY = @SECRET_KEY@
INTERNAL_TOKEN = @INTERNAL_TOKEN@
PASSWORD_HASH_ALGO = argon2
MIN_PASSWORD_LENGTH = 16

[session]
PROVIDER = db
COOKIE_SECURE = true
COOKIE_NAME = ov_git_session

[mailer]
ENABLED = false

[picture]
DISABLE_GRAVATAR = true
ENABLE_FEDERATED_AVATAR = false

[ui]
; openvibe: Forgejo's dark theme in OpenVibe's colours (custom/public/assets/css/theme-openvibe.css).
DEFAULT_THEME = openvibe
THEMES = openvibe,forgejo-auto,forgejo-light,forgejo-dark

[ui.meta]
AUTHOR = OpenVibers
DESCRIPTION = OpenVibe Git: the OpenVibe projects' own source, with your OpenVibe account.

[mirror]
ENABLED = true
DEFAULT_INTERVAL = 8h
MIN_INTERVAL = 10m

[migrations]
ALLOWED_DOMAINS = github.com,*.github.com,codeberg.org
ALLOW_LOCALNETWORKS = false

[actions]
ENABLED = false

[federation]
ENABLED = false

[log]
MODE = console
LEVEL = Info

[cron.update_mirrors]
SCHEDULE = @every 1h
