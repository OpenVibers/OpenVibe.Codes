# /etc/openvibe/codes-sandbox.env — the chat plays sandbox worker (sandbox/worker.js). No secret goes here: the two
# secrets are systemd credentials in /etc/openvibe/codes-sandbox/ (see install.sh).

# The worker's name in Codes and Live.
CODES_SANDBOX_WORKER_ID=sbw-ovhost

# Per sandbox: memory (MiB; the tmpfs areas are added on top), each tmpfs area's size (MiB: /workspace, /home/agent,
# /tmp), processes and threads, CPU (100 = one core). Sandboxes at once.
CODES_SANDBOX_MEMORY_MB=2048
CODES_SANDBOX_DISK_MB=512
CODES_SANDBOX_PIDS=256
CODES_SANDBOX_CPU_PERCENT=100
CODES_SANDBOX_MAX_SESSIONS=2
# The longest time box a session may have (the owner sets 5 to 30 minutes).
CODES_SANDBOX_TIME_BOX_MAX_MIN=30

# Node for the supervisor inside the sandbox (bound read-only), and the headless Chromium install.sh put in place.
CODES_SANDBOX_NODE=/usr/bin/node
#CODES_SANDBOX_BROWSER=/opt/openvibe-codes-sandbox/browser/chromium_headless_shell-NNNN/chrome-headless-shell-linux64/chrome-headless-shell

# Codes: where the signed heartbeat goes (loopback). The secret is the credential codes-worker-secret, and the same
# value is CODES_SANDBOX_WORKER_SECRET in /etc/openvibe/codes.env.
CODES_SANDBOX_CODES_URL=http://127.0.0.1:4900

# Live: the check-in (POST /api/streams/agent/:id/plays/worker) with the worker's own Network service token
# (client credentials; audience openvibe.live; capability live.agent_sandbox.register). The client secret is the
# credential network-client-secret. CODES_SANDBOX_LIVE_STREAMS: the agent streams this worker serves (comma list);
# a running session's own stream is added for its lifetime.
CODES_SANDBOX_LIVE_URL=https://openvibe.live
CODES_SANDBOX_NETWORK_URL=https://openvibe.network
CODES_SANDBOX_CLIENT_ID=
CODES_SANDBOX_LIVE_STREAMS=

# How often: the check-ins (every 30 s) and the self-test (every 10 minutes).
CODES_SANDBOX_ANNOUNCE_MS=30000
CODES_SANDBOX_SELFTEST_MS=600000
