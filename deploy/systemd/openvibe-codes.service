[Unit]
Description=OpenVibe.Codes — the open coding-agent harness (the agent catalog and router, Improve OpenVibe; the developer console moved to OpenVibe.Services)
# Network (sign-in, JWKS, the projects API, registry, tokens) and Events (the outbox relay) should be
# up first, but Codes degrades honestly without them: docs, tools and policy pages serve; project
# pages show Network's failure; events wait in the outbox (see /api/ready).
After=network.target postgresql.service pgbouncer.service valkey-server.service
Wants=openvibe-network.service postgresql.service pgbouncer.service valkey-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/openvibe.codes
EnvironmentFile=/etc/openvibe/codes.env
Environment=NODE_ENV=production
Environment=PORT=4900
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /opt/openvibe.codes/server/index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Codes' own database is PostgreSQL on the host's data role; the code tree stays read-only.

[Install]
WantedBy=multi-user.target
